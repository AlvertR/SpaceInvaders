# Tooling del apsys-ai-toolkit. Los skills instalados NO se versionan —cada dev los
# instala—, pero los dos lock files SI: son los que registran qué versión corre
# cada quien. Sin ellos el repositorio no lo sabe y nadie puede reproducirlo.
/.claude/skills/bg-review-pr-code
/.claude/skills/packs
/openspec/schemas

# Version de terragrunt fijada localmente por tgswitch/tgenv
.terragrunt-version

# Secretos de los compose, interpolados por Docker Compose en la instancia. El
# de produccion lleva SEIS entradas y el de testing UNA (KC-1381; KC-1300 dejo
# la primera del de produccion). Las PLANTILLAS —.env.example, al lado de cada
# compose— si se versionan; los .env con los valores nunca.
#
# UNA RUTA COMPLETA POR AMBIENTE, y no un patron `.env` suelto: asi la exclusion
# no alcanza en silencio a otro .env de otro ambiente, y agregar un ambiente
# obliga a agregar su linea en vez de quedar cubierto por accidente.
/environments_v2/03_production/scripts/.env
/environments_v2/02_testing/scripts/.env
